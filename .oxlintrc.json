{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist", "node_modules", "coverage", "docs"],
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  }
}
