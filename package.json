{
  "name": "merge-mentor",
  "version": "3.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archerax/merge-mentor.git"
  },
  "description": "Automated code review bot powered by AI CLI tools (Copilot, OpenCode, Cursor)",
  "main": "dist/cli.js",
  "bin": {
    "merge-mentor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --noEmit && cross-env NODE_ENV=production node build.mjs",
    "build:dev": "tsc --noEmit && node build.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "node dist/cli.js eval",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"**/*.{md,yml}\" && biome check && knip",
    "lint:fix": "prettier --write \"**/*.{md,yml}\" && biome check --write && knip --fix",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:site": "typedoc --options typedoc.site.json",
    "docs:serve": "pnpm docs:site && node scripts/docs-serve.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "code-review",
    "github",
    "azure-devops",
    "copilot",
    "pull-request",
    "automated-review",
    "cli",
    "pr-review",
    "code-quality",
    "static-analysis"
  ],
  "author": "archerax",
  "license": "MIT",
  "preferGlobal": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@github/copilot-sdk": "^1.0.14",
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "^1.18.31",
    "azure-devops-node-api": "^17.0.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.1",
    "isomorphic-git": "^1.42.2",
    "micromatch": "^4.0.8",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
