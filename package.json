{
  "name": "merge-mentor",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archerax/merge-mentor.git"
  },
  "description": "Automated code review bot powered by AI CLI tools (Copilot, OpenCode)",
  "main": "dist/cli.js",
  "bin": {
    "merge-mentor": "dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:root && pnpm -r --if-present run build && pnpm run build:web",
    "build:root": "tsc --build && cross-env NODE_ENV=production node build.mjs",
    "build:web": "node scripts/bundle-web.mjs",
    "build:dev": "pnpm run build:dev:root && pnpm -r --if-present run build:dev",
    "build:dev:root": "tsc --build && node build.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "start": "node dist/cli.js",
    "test": "pnpm run test:root && pnpm -r --if-present run test",
    "test:root": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "eval": "node dist/cli.js eval",
    "ui": "pnpm --filter @merge-mentor/web dev",
    "typecheck": "pnpm run typecheck:root && pnpm --filter @merge-mentor/web run typecheck",
    "typecheck:root": "tsc --build",
    "lint": "pnpm run lint:root && pnpm -r --if-present run lint",
    "lint:root": "oxfmt --check && oxlint && knip",
    "lint:fix": "pnpm run lint:fix:root && pnpm -r --if-present run lint:fix",
    "lint:fix:root": "oxfmt --write && oxlint --fix && knip --fix",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:site": "typedoc --options typedoc.site.json",
    "docs:serve": "pnpm docs:site && node scripts/docs-serve.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "code-review",
    "github",
    "azure-devops",
    "copilot",
    "pull-request",
    "automated-review",
    "cli",
    "pr-review",
    "code-quality",
    "static-analysis"
  ],
  "author": "archerax",
  "license": "MIT",
  "preferGlobal": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@github/copilot-sdk": "^1.0.23",
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "^1.19.3",
    "azure-devops-node-api": "^17.0.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.8",
    "isomorphic-git": "^1.44.3",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
