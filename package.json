{
  "name": "merge-mentor",
  "version": "3.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archerax/merge-mentor.git"
  },
  "description": "Automated code review bot powered by AI CLI tools (Copilot, OpenCode)",
  "private": true,
  "main": "dist/cli.js",
  "bin": {
    "merge-mentor": "dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:root && pnpm -r --if-present run build",
    "build:root": "tsc --noEmit && cross-env NODE_ENV=production node build.mjs",
    "build:dev": "pnpm run build:dev:root && pnpm -r --if-present run build:dev",
    "build:dev:root": "tsc --noEmit && node build.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "start": "node dist/cli.js",
    "test": "pnpm run test:root && pnpm -r --if-present run test",
    "test:root": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "eval": "node dist/cli.js eval",
    "ui": "pnpm --filter @merge-mentor/web dev",
    "typecheck": "pnpm run typecheck:root && pnpm -r --if-present run typecheck",
    "typecheck:root": "tsc --noEmit",
    "lint": "pnpm run lint:root && pnpm -r --if-present run lint",
    "lint:root": "oxfmt --check && oxlint && knip",
    "lint:fix": "pnpm run lint:fix:root && pnpm -r --if-present run lint:fix",
    "lint:fix:root": "oxfmt --write && oxlint --fix && knip --fix",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:site": "typedoc --options typedoc.site.json",
    "docs:serve": "pnpm docs:site && node scripts/docs-serve.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "code-review",
    "github",
    "azure-devops",
    "copilot",
    "pull-request",
    "automated-review",
    "cli",
    "pr-review",
    "code-quality",
    "static-analysis"
  ],
  "author": "archerax",
  "license": "MIT",
  "preferGlobal": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@github/copilot-sdk": "^1.0.16",
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "^1.18.34",
    "azure-devops-node-api": "^17.0.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.5",
    "isomorphic-git": "^1.43.0",
    "micromatch": "^4.0.8",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
