{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "search.exclude": {
    "node_modules": true,
    "dist": true,
    "coverage": true
  },
  "files.exclude": {
    "node_modules": true,
    "dist": true,
    "coverage": true
  },
  "debug.javascript.autoAttachFilter": "smart",
  "debug.javascript.autoExpandGetters": false,
  "debug.javascript.terminalOptions": {
    "skipFiles": ["<node_internals>/**"]
  }
}
